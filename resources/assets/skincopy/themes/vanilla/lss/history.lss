// Mermil Paradis 0.4: light profile workspace, soft raised cards, inset search.
Document { background-color: #e9edf3; }
Component { shadow: false; text-color: #303747; }
.mermil-icon { left: 14; top: 12; width: 26; height: 26; object-fit: contain; }
.mermil-title { left: 48; top: 12; width: 100; height: 14; text-color: #37324b; }
.mermil-subtitle { left: 49; top: 28; width: 100; height: 10; font-size: small; text-color: #77758b; }
.mermil-header-action {
    top: 14; height: 24; renderer: "Background"; background-color: #e9edf3;
    border-radius: 7;
    Component { text-color: #454359; }
    &:enabled:hover { background-color: #ddd9ec; }
}
.mermil-own { right: 106; width: 76; }
.mermil-options { right: 14; width: 86; }
.mermil-return { left: 14; width: 90; top: 48; }
.mermil-input { left: 14; right: 94; top: 50; height: 26; background-color: #e2e7ef; border: none; border-radius: 8; text-color: #303747; text-shadow: false; }
.mermil-search { right: 14; top: 50; width: 72; height: 26; renderer: "Background"; background-color: #7862b3; border-radius: 8;
    Component { text-color: white; }
    &:enabled:hover { background-color: #69519f; }
    &:not(:enabled) { background-color: #c1b9d6; }
}
.mermil-identity { left: 16; right: 14; top: 86; height: 18; font-size: large; text-color: #303747; }
.mermil-identity-sub { left: 16; right: 14; top: 108; height: 10; font-size: small; text-color: #6a7082; }
.mermil-scroll { left: 8; right: 8; bottom: 26; padding: 7; background-color: 0; }
.mermil-player-content { top: 124; }
.mermil-tools-content { top: 80; }
.mermil-list { width: 100%; height: fit-content; }
.mermil-columns { width: 100%; height: fit-content; orientation: horizontal; space-between-entries: 12; }
.mermil-preview-card { width: 160; height: fit-content; padding: 8; renderer: "Background"; background-color: #e9edf3; border-radius: 12; }
.mermil-preview-card.mermil-stacked { width: 100%; }
.mermil-details-card { width: 100%; height: fit-content; padding: 8; renderer: "Background"; background-color: #e9edf3; border-radius: 12; }
.mermil-skin-model { width: 100%; height: 144; base-scale: 0.9; center-model: true; }
.mermil-tabs { width: 100%; height: 26; orientation: horizontal; space-between-entries: 4; margin-bottom: 8; }
.mermil-tab { width: 100%; height: 26; renderer: "Background"; background-color: #e0e5ed; border-radius: 8;
    Component { text-color: #626578; }
    &:enabled:hover { background-color: #d6dce6; }
    &.mermil-tab-active { background-color: #dcd5ee; Component { text-color: #554178; } }
}
.mermil-section { width: 100%; height: 18; margin-top: 6; padding-left: 5; font-size: small; text-color: #625777; }
.mermil-line { width: 100%; height: 18; padding: 0 5; text-color: #454d60; overflow-strategy: clip; }
.mermil-row-detail { width: 100%; height: 14; padding-left: 8; font-size: small; text-color: #697183; overflow-strategy: clip; }
.mermil-row { width: 100%; height: 24; orientation: horizontal; padding: 0 6; renderer: "Background"; background-color: #f2f4f8; border-radius: 5; }
.mermil-row-name { alignment-y: center; overflow-strategy: clip; text-color: #303747; }
.mermil-row-meta { alignment-y: center; margin-left: 5; max-width: 45%; overflow-strategy: clip; text-color: #697183; }
.mermil-copy { width: 100%; height: 100%; renderer: "Background"; background-color: 0; padding: 0;
    Component { alignment-x: left; text-color: #51426c; }
    &:enabled:hover { background-color: #e3ddef; }
}
.mermil-copy-icon { width: 14; height: 14; alignment-y: center; margin-left: 3; renderer: "Background"; background-color: 0;
    Icon { width: 10; height: 10; alignment-x: center; alignment-y: center; }
}
.mermil-action { width: 100%; height: 26; margin: 2; padding: 0 6; renderer: "Background"; background-color: #e9edf3; border-radius: 7;
    Component { text-color: #41485b; alignment-x: left; }
    &:enabled:hover { background-color: #ddd7ed; }
    &:not(:enabled) { background-color: #e0e4eb; Component { text-color: #8a8e9c; } }
}
.mermil-primary { background-color: #7862b3; Component { text-color: white; }
    &:enabled:hover { background-color: #69519f; }
    &:not(:enabled) { background-color: #c1b9d6; }
}
.mermil-setting { width: 100%; height: 30; orientation: horizontal; padding: 0 8; renderer: "Background"; background-color: #f2f4f8; border-radius: 7; }
.mermil-setting-label { height: 30; alignment-y: center; overflow-strategy: clip; text-color: #303747; }
.mermil-switch { width: 42; height: 20; alignment-y: center; }
.mermil-skin-grid { width: 100%; height: fit-content; }
.mermil-sighting { width: 100%; height: 86; padding: 4; renderer: "Background"; background-color: #f2f4f8; border-radius: 8; }
.mermil-status { left: 14; right: 14; bottom: 7; height: 12; font-size: small; text-color: #656c80; overflow-strategy: clip; }
