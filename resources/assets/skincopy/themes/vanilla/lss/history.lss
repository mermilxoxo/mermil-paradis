// 0.4.2: flow layout, natural text height, separate brand/navigation/search rows.
Document { background-color: #edf0f5; }
Component { shadow: false; font-size: 1; text-color: #252b3b; }
.mermil-icon { left: 12; top: 8; width: 30; height: 30; object-fit: contain; }
.mermil-title { left: 52; top: 9; right: 12; height: 14; text-color: #3f2b69; }
.mermil-subtitle { left: 52; top: 25; right: 12; height: 12; text-color: #444d61; }
.mermil-header-action { top: 46; height: 24; renderer: "Background"; background-color: #dadfee; border-radius: 5; }
.mermil-own { left: 12; right: 51%; }
.mermil-options { left: 51%; right: 12; }
.mermil-input { left: 12; right: 94; top: 80; height: 26; background-color: #ffffff; border-radius: 5; text-color: #252b3b; text-shadow: false; }
.mermil-search { right: 12; top: 80; width: 74; height: 26; renderer: "Background"; background-color: #d6c9ec; border-radius: 5; }
.mermil-scroll { left: 8; right: 8; bottom: 10; padding: 4; background-color: 0; }
.mermil-player-content { top: 114; }
.mermil-tools-content { top: 80; }
.mermil-list { width: 100%; height: fit-content; space-between-entries: 6; squeeze-height: false; }
.mermil-preview-card, .mermil-details-card, .mermil-history-card {
    width: 100%; height: fit-content; padding: 8; margin-bottom: 8;
    renderer: "Background"; background-color: #ffffff; border-radius: 6; squeeze-height: false;
}
.mermil-skin-model { width: 100%; height: 144; center-model: true; base-scale: 0.9; }
.mermil-tabs { width: 100%; height: 28; orientation: horizontal; space-between-entries: 4; }
.mermil-tab { width: 100%; height: 28; renderer: "Background"; background-color: #e3e7f0; border-radius: 4;
    &.mermil-tab-active { background-color: #cdbce6; }
}
.mermil-section { width: 100%; height: fit-content; min-height: 18; margin-top: 6; padding: 2 4; font-size: 1; text-color: #3f2b69; overflow-strategy: wrap; }
.mermil-line { width: 100%; height: fit-content; min-height: 18; padding: 3 4; overflow-strategy: wrap; text-color: #252b3b; }
.mermil-row-detail { width: 100%; height: fit-content; min-height: 16; padding: 2 4; font-size: 1; overflow-strategy: wrap; text-color: #444d61; }
.mermil-row { width: 100%; height: 28; orientation: horizontal; renderer: "Background"; background-color: #e3e7f0; padding: 0 4; border-radius: 4; }
.mermil-row-name { alignment-y: center; overflow-strategy: clip; text-color: #252b3b; }
.mermil-row-meta { alignment-y: center; margin-left: 4; max-width: 45%; text-color: #444d61; overflow-strategy: clip; }
.mermil-action, .mermil-copy { width: 100%; height: 30; renderer: "Background"; background-color: #e3e7f0; padding: 0 6; border-radius: 5;
    &:enabled:hover { background-color: #d6c9ec; }
    &:not(:enabled) { background-color: #e5e7eb; Component { text-color: #626879; } }
}
.mermil-primary, .mermil-dashboard-open { background-color: #d6c9ec; }
// Buttons wrap their label in a HorizontalListEntry: size that wrapper explicitly.
.mermil-action .button-text, .mermil-copy .button-text, .mermil-header-action .button-text, .mermil-tab .button-text, .mermil-search .button-text {
    width: 100%; height: 100%;
    Component { width: 100%; height: 100%; font-size: 1; scale-to-fit: false; text-color: #252b3b; alignment-x: center; alignment-y: center; }
}
.mermil-copy-icon { width: 18; height: 18; alignment-y: center; Icon { width: 12; height: 12; alignment-x: center; alignment-y: center; } }
.mermil-setting { width: 100%; height: fit-content; min-height: 34; orientation: horizontal; padding: 6; renderer: "Background"; background-color: #ffffff; }
.mermil-setting-label { height: fit-content; min-height: 22; padding-right: 8; overflow-strategy: wrap; text-color: #252b3b; }
.mermil-switch { width: 42; height: 20; alignment-y: center; }
.mermil-status { left: 12; right: 12; bottom: 6; height: 16; font-size: 1; text-color: #444d61; overflow-strategy: clip; }
